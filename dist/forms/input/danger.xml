<Alloy>
  <TikitInput module="tikit.ui" id="$.args.id" component="input" class="vertical mb-2 h-auto w-screen" classes="$.args.classes">
    <Label module="tikit.ui" if="$.args.label" id="label" classes="$.args.classes" class="text-red-500 w-screen text-left text-sm h-auto" text="$.args.label" />
    <TextField module="tikit.ui" if="$.args.inputType !== 'textarea'" id="input" classes="$.args.classes" required="$.args.required" keyboardType="$.args.keyboardType" keyboardAppearance="$.args.keyboardAppearance" returnKeyType="$.args.returnKeyType" enableReturnKey="$.args.enableReturnKey" suppressReturn="$.args.suppressReturn" passwordMask="$.args.passwordMask" maxLength="$.args.maxLength" clearOnEdit="$.args.clearOnEdit" autocapitalization="$.args.autocapitalization" autocorrect="$.args.autocorrect" autofillType="$.args.autofillType" class="hint-text-red-300 text-red-600 mt-0.5 h-10 w-screen rounded border-red-500 bg-white/85 p-2 text-base normal-case" value="$.args.value" hintText="$.args.hintText" />
    <TextArea module="tikit.ui" if="$.args.inputType === 'textarea'" id="input" classes="$.args.classes" required="$.args.required" keyboardType="$.args.keyboardType" keyboardAppearance="$.args.keyboardAppearance" returnKeyType="$.args.returnKeyType" enableReturnKey="$.args.enableReturnKey" suppressReturn="$.args.suppressReturn" passwordMask="$.args.passwordMask" maxLength="$.args.maxLength" clearOnEdit="$.args.clearOnEdit" autocapitalization="$.args.autocapitalization" autocorrect="$.args.autocorrect" autofillType="$.args.autofillType" class="hint-text-red-300 text-red-600 mt-0.5 w-screen rounded border-red-500 bg-white/85 ios:px-1 py-2 android:px-2 text-base normal-case h-24" value="$.args.value" hintText="$.args.hintText" />
    <Label id="error" class="ml-0 hidden text-left text-xs text-red-600" text="$.args.errorMessage" />
  </TikitInput>
</Alloy>
