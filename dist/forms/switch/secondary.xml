<Alloy>
  <TikitInput module="tikit.ui" id="$.args.id" component="input" class="vertical mb-2 h-auto w-screen" classes="$.args.classes">
    <Label module="tikit.ui" if="$.args.label" id="label" classes="$.args.classes" class="text-secondary-900 w-screen text-left text-sm h-auto" text="$.args.label" />
    <TikitSwitch module="tikit.ui" id="input" classes="$.args.classes" required="$.args.required" variant="switch" value="$.args.value" class="tint-color-secondary-800 on-tint-secondary thumb-secondary-300 mt-0.5 h-auto" />
    <Label id="error" class="ml-0 hidden text-left text-xs text-red-600" text="$.args.errorMessage" />
  </TikitInput>
</Alloy>
